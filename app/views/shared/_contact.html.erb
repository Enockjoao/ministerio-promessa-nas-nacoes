<!-- Contato Section -->
<section class="contato-section" id="contato">
  <div class="container">
    
    <!-- Título -->
    <div class="contato-header text-center">
      <h2 class="contato-titulo">Fale Conosco</h2>
      <p class="contato-subtitulo">Queremos ouvir você. Seja para oração, dúvidas ou visitação, estamos aqui.</p>
    </div>

    <!-- Cards de Contato Rápido -->
    <div class="row g-4 justify-content-center mb-5">
      
      <!-- Endereço -->
      <div class="col-md-4">
        <a href="https://www.google.com/maps/place/Minist%C3%A9rio+Promessa+Nas+Na%C3%A7%C3%B5es/@-15.9119491,-48.0566114,17z/data=!3m1!4b1!4m6!3m5!1s0x935a2d5d8dd94a83:0x4c77dd85443db005!8m2!3d-15.9119543!4d-48.0540365!16s%2Fg%2F11gksh5npf?entry=ttu&g_ep=EgoyMDI2MDEyNi4wIKXMDSoASAFQAw%3D%3D" target="_blank" class="card-contato">
          <div class="card-icon">
            <i class="bi bi-geo-alt-fill"></i>
          </div>
          <h3>Endereço</h3>
          <p>ADE QD 402 conjunto 05 lote 19 - Recanto das Emas<br> Brasília - DF</p>
          <span class="card-link">Ver no mapa →</span>
        </a>
      </div>

      <!-- WhatsApp -->
      <div class="col-md-4">
        <a href="https://wa.me/5561999999999?text=Olá! Gostaria de saber mais sobre a igreja." target="_blank" class="card-contato card-whatsapp">
          <div class="card-icon">
            <i class="bi bi-whatsapp"></i>
          </div>
          <h3>WhatsApp</h3>
          <p>(61) 99999-9999</p>
          <span class="card-link">Iniciar conversa →</span>
        </a>
      </div>

      <!-- E-mail -->
      <div class="col-md-4">
        <a href="mailto:contato@promessanasnacoes.com.br" class="card-contato">
          <div class="card-icon">
            <i class="bi bi-envelope-fill"></i>
          </div>
          <h3>E-mail</h3>
          <p>contato@promessa<br>nasnacoes.com.br</p>
          <span class="card-link">Enviar e-mail →</span>
        </a>
      </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="formulario-wrapper">
          <h3>Envie sua Mensagem</h3>
          
          <%= form_with url: "#", method: :post, local: true, class: "formulario-contato" do %>
            
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="nome">Nome</label>
                  <input type="text" name="nome" id="nome" class="form-control" placeholder="Seu nome" required>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label for="email">E-mail</label>
                  <input type="email" name="email" id="email" class="form-control" placeholder="seu@email.com" required>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="telefone">WhatsApp</label>
                  <input type="tel" name="telefone" id="telefone" class="form-control" placeholder="(61) 99999-9999">
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label for="assunto">Assunto</label>
                  <select name="assunto" id="assunto" class="form-select" required>
                    <option value="" disabled selected>Selecione</option>
                    <option value="oracao">Pedido de Oração</option>
                    <option value="visitacao">Quero Visitar</option>
                    <option value="ministerios">Participar de Ministério</option>
                    <option value="duvidas">Dúvidas</option>
                    <option value="outro">Outro</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="mensagem">Mensagem</label>
              <textarea name="mensagem" id="mensagem" class="form-control" rows="5" placeholder="Sua mensagem..." required></textarea>
            </div>

            <button type="submit" class="btn-enviar">
              Enviar Mensagem
              <i class="bi bi-send-fill"></i>
            </button>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</section>