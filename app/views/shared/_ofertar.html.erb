<section id="ofertar" class="ofertar-section">
    <div class="container">
        <div class="ofertar-content">
            <h2 class="section-title">Ofertar</h2>
            <p class="section-subtitle">Contribua com o ministério</p>
            
            <div class="ofertar-image-container">
                <%= image_tag "oferta.jpeg", alt: "Seja um Semeador - QR Code para ofertas", class: "ofertar-image" %>
            </div>
            
            <div class="ofertar-text">
                <p class="verse">"Lembrem-se: Aquele que semeia pouco também colherá pouco, e aquele que semeia com fartura também colherá fartamente."</p>
                <p class="verse-reference">2 Coríntios 9:6-7</p>
            </div>
        </div>
    </div>
</section>