<section class="ministries">
        <div class="section-container">
            <div class="section-header">
                <p class="section-tag">Faça Parte</p>
                <h2 class="section-title">Nossos Ministérios</h2>
            </div>
            <div class="ministry-grid">
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=400" alt="Louvor">
                    <div class="ministry-overlay">
                        <h4>Nação Praise</h4>
                        <p>Equipe de músicos e cantores</p>
                    </div>
                </div>
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1609234656388-0ff363383899?w=400" alt="Jovens">
                    <div class="ministry-overlay">
                        <h4>Braseiros</h4>
                        <p>Jovens apaixonados por Jesus</p>
                    </div>
                </div>
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=400" alt="Crianças">
                    <div class="ministry-overlay">
                        <h4>Kids</h4>
                        <p>Ensino criativo para crianças</p>
                    </div>
                </div>
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=400" alt="Missões">
                    <div class="ministry-overlay">
                        <h4>Luz Do Mundo</h4>
                        <p>Levando esperança às nações</p>
                    </div>
                </div>
                <div class="ministry-card">
                    <%= image_tag "jesusEmCasa.jpeg", alt: "Jesus Em Casa" %>
                    <div class="ministry-overlay">
                    </div>
                </div>
                 <div class="ministry-card">
                    <%= image_tag "nacaodance.jpeg", alt: "Nação Dance" %>
                    <div class="ministry-overlay">
                    </div>
                </div>
            </div>
            </div>
        </div>
    </section>